<odoo>
    <data>
        <!-- Inheriting the Invoice report template -->
        <template id="custom_invoice_report_inherit" inherit_id="account.report_invoice_document">

            <!-- Add the new payment information rows -->
            <xpath expr="//table[@class='table table-sm o_main_table']" position="after">
                <div class="clearfix" name="so_total_summary_new">
                    <div id="total" class="row" name="total">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">
                            <table class="table table-sm">
                                <!-- Tax totals -->
                                <t t-set="tax_totals" t-value="json.loads(doc.tax_totals_json)"/>

                                <!-- Untaxed Amount -->
                                <tr style="border-top: 0px solid !important; border-bottom: 2px solid !important;">
                                    <td class="text-start" style="border-top: 0px solid !important;">
                                        <span>Untaxed Amount</span>
                                    </td>
                                    <td class="text-start" style="border-top: 0px solid !important;">
                                        <span t-field="doc.amount_untaxed"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>

                                <!-- Taxes -->
                                <tr style="border-bottom: 2px solid !important;">
                                    <td class="text-start">
                                        <span>Vat (14%)</span>
                                    </td>
                                    <td class="text-start">
                                        <span t-field="doc.amount_tax"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>

                                <!-- Total -->
                                <tr style="border-bottom: 2px solid !important;">
                                    <td class="text-start">
                                        <span>Total</span>
                                    </td>
                                    <td class="text-start" style="font-weight:bold !important;">
                                        <strong>
                                            <span t-esc="'{:.2f}'.format(doc.amount_total)"
                                                  style="font-weight: bold;"/>
                                            <span t-field="doc.currency_id.symbol" style="font-weight: bold;"/>
                                        </strong>
                                    </td>
                                </tr>

                                <!-- Paid Amount and Date -->
                                <t t-if="doc.payment_state == 'paid'">
                                    <tr style="border-bottom: 2px solid !important;">
                                        <td class="text-start">
                                            <span>Paid on <t t-esc="doc.payment_date"/></span>
                                        </td>
                                        <td class="text-start" style="font-weight:bold !important;">
                                            <strong>
                                                <span t-esc="'{:.2f}'.format(doc.amount_paid)"
                                                      style="font-weight: bold;"/>
                                                <span t-field="doc.currency_id.symbol" style="font-weight: bold;"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Amount Due -->
                                <tr style="border-bottom: 2px solid !important;">
                                    <td class="text-start">
                                        <span>Amount Due</span>
                                    </td>
                                    <td class="text-start" style="font-weight:bold !important;">
                                        <strong>
                                            <span t-esc="'{:.2f}'.format(doc.amount_total - doc.amount_paid)"
                                                  style="font-weight: bold;"/>
                                            <span t-field="doc.currency_id.symbol" style="font-weight: bold;"/>
                                        </strong>
                                    </td>
                                </tr>

                            </table>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Hide or modify the original 'total' block if necessary -->
            <xpath expr="//div[@name='total']" position="attributes">
                <attribute name="class">d-none</attribute>
            </xpath>

        </template>
    </data>
</odoo>
